{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "package.json",
      "package-lock.json",
      "vitest.config.js",
      "LEIAME.md",
      "**/.*",
      "**/node_modules/**",
      "tests/**",
      "scripts/**",
      "ia/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
      },
    "singleProjectMode": true
  }
}
